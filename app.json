{
  "expo": {
    "name": "MPOWERED",
    "slug": "mpowered",
    "scheme": "mpowered",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MPOWERED to record a healthcare practitioner's answer after they give consent.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MPOWERED to fill in a support person from a contact you choose."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
